APP_NAME=Petly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://petly.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# One Pixelforge API key per environment: each has its own webhook URL,
# signing secret and usage report. Point the key's webhook URL at
# https://<your-host>/webhooks/pixelforge in the Pixelforge dashboard.
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_MARKUP_PERCENT=25

# Demo accounts created by `php artisan db:seed`: comma-separated
# email:name:credits entries (whole dollars), with :admin appended for admins.
# They all get DEMO_USERS_PASSWORD. Leave DEMO_USERS empty to seed none.
DEMO_USERS="admin@example.com:Armen Samvelyan:10:admin,daniel@example.com:Daniel Brooks:25,sofia@example.com:Sofia Martinez:25,liam@example.com:Liam Walker:0,hannah@example.com:Hannah Kim:50,marcus@example.com:Marcus Reed:5,elena@example.com:Elena Rossi:100,nora@example.com:Nora Bennett:1"
DEMO_USERS_PASSWORD=11112222
